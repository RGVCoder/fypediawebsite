# Public browser configuration. Copy to .env.local for a local build.
FYPEDIA_INSFORGE_URL=https://your-project.us-east.insforge.app
FYPEDIA_INSFORGE_ANON_KEY=your-public-anon-key

# Optional: leave blank to use the deployed page's own origin/path as redirectTo.
# The exact production and localhost URLs must be allowlisted in InsForge Auth.
FYPEDIA_OAUTH_REDIRECT_TO=

# Google OAuth client ID and secret belong only in InsForge provider settings.
# Never put a Google client secret in this file or dist/config.js.
